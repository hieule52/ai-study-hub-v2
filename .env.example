# ==============================================================================
# AI STUDY HUB LMS - ENVIRONMENT CONFIGURATION TEMPLATE
# Sao chép tệp này thành '.env' và cấu hình lại các giá trị phù hợp cho hệ thống của bạn.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Cấu hình Cơ sở dữ liệu)
# ------------------------------------------------------------------------------
# Khi chạy Docker, DB_HOST nội bộ được Docker Compose tự động ánh xạ đến container 'db'.
# Nếu chạy thủ công ngoài docker, sử dụng 'localhost' hoặc IP tương ứng.
DB_HOST=localhost
DB_NAME=aistudyhublms
DB_USER=root
DB_PASS=123456

# ------------------------------------------------------------------------------
# 2. APPLICATION CONFIGURATION (Cấu hình ứng dụng)
# ------------------------------------------------------------------------------
APP_ENV=production                  # 'development' hoặc 'production'
APP_URL=http://localhost:8000       # Thay bằng URL Cloudflare Tunnel / VPS Domain khi chạy thực tế

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Xác thực JWT & Bảo mật mã hóa)
# ------------------------------------------------------------------------------
# THAY ĐỔI khóa bảo mật này thành một chuỗi ký tự ngẫu nhiên dài hơn trong môi trường production!
JWT_SECRET=super_secret_key_change_me_in_production_99xY2
JWT_EXPIRATION=7200                 # Thời hạn hiệu lực của Token (giây) - Mặc định 2 giờ

# ------------------------------------------------------------------------------
# 4. AI INTEGRATION KEYs (Khóa tích hợp trí tuệ nhân tạo)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 5. PAYMENT & INTEGRATION (Cổng ghi danh thanh toán)
# ------------------------------------------------------------------------------
CASSO_API_KEY=your_casso_api_key_here
VIP_SECRET=your_vip_secret_here
VIP_AMOUNT_VND=500000

# ------------------------------------------------------------------------------
# 6. VIDEO SECURITY & STORAGE (Bảo mật video & Lưu trữ)
# ------------------------------------------------------------------------------
VIDEO_STORAGE_PATH=storage/private/videos
VIDEO_TOKEN_SECRET=change_this_to_a_random_video_token_secret_88zQ7
VIDEO_TOKEN_EXPIRY=14400            # Thời hạn token phát video bảo mật (giây) - 4 giờ
VIDEO_MAX_SIZE_MB=500               # Dung lượng tải lên video tối đa (đã được map với php.ini)