# ============================================================
# AI Study Hub LMS — Apache Rewrite & Security Rules
# ============================================================

Options -Indexes
RewriteEngine On

# ── Security: Block direct access to sensitive files ─────────
RewriteRule ^\.env$                         - [F,L]
RewriteRule ^composer\.(json|lock)$         - [F,L]
RewriteRule ^\.git/                         - [F,L]
RewriteRule ^vendor/                        - [F,L]
RewriteRule ^(core|app|database|routes|storage)/  - [F,L]

# ── Allow static assets (CSS/JS/images/uploads) to pass ──────
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── Route everything else to the Front Controller ────────────
RewriteRule ^ index.php [QSA,L]
