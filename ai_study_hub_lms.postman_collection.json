{
  "info": {
    "_postman_id": "8b939fa9-4a4a-4e89-bd6c-7e616f731c3c",
    "name": "AI Study Hub LMS",
    "description": "Postman Collection for testing AI Study Hub LMS V2 API, including Auth (Register/Login) and User Profile.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Đăng ký Học viên (Register Student)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"hocvien_test\",\n    \"email\": \"hocvien@example.com\",\n    \"password\": \"12345678\",\n    \"role\": \"student\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Đăng ký tài khoản mới với vai trò là Học viên (student)"
          },
          "response": []
        },
        {
          "name": "2. Đăng ký Giảng viên (Register Teacher)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"giangvien_test\",\n    \"email\": \"giangvien@example.com\",\n    \"password\": \"12345678\",\n    \"role\": \"teacher\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Đăng ký tài khoản mới với vai trò là Giảng viên (teacher)"
          },
          "response": []
        },
        {
          "name": "3. Đăng nhập (Login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.data.token);",
                  "    console.log(\"Saved JWT token to collection variables!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"hocvien@example.com\",\n    \"password\": \"12345678\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Đăng nhập bằng Email và Password. Khi đăng nhập thành công, Postman sẽ tự động lưu token JWT vào biến của Collection để sử dụng cho các API cần xác thực khác."
          },
          "response": []
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Xem thông tin cá nhân (Get Profile)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/user/profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "profile"
              ]
            },
            "description": "Lấy thông tin cá nhân của User hiện tại (Yêu cầu JWT Token trong header Bearer)"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ]
